{
  "rewrites": [
    { "source": "/login",  "destination": "/app.html" },
    { "source": "/master", "destination": "/app.html" },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "(?<slug>(?!www)[^.]+)\\.agenplus\\.com\\.br" }],
      "destination": "/app.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "(?<slug>(?!www)[^.]+)\\.agenplus\\.com\\.br" }],
      "destination": "/app.html"
    }
  ]
}
