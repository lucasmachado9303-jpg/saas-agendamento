{
  "rewrites": [
    { "source": "/login",       "destination": "/app.html" },
    { "source": "/master",      "destination": "/app.html" },
    { "source": "/gestao",      "destination": "/app.html" },
    { "source": "/agendar",     "destination": "/app.html" },
    { "source": "/confirmacao", "destination": "/app.html" },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "(?<slug>(?!www\\b)[^.]+)\\.agenplus\\.com\\.br" }],
      "destination": "/app.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "(?<slug>(?!www\\b)[^.]+)\\.agenplus\\.com\\.br" }],
      "destination": "/app.html"
    }
  ]
}
